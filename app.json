{
  "expo": {
    "name": "PRism",
    "slug": "prism",
    "version": "0.1.0",
    "scheme": "prism",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070B",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.prism.trainer"
    },
    "android": {
      "package": "app.prism.trainer",
      "adaptiveIcon": {
        "backgroundColor": "#07070B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#07070B",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
