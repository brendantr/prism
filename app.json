{
  "expo": {
    "name": "PRism",
    "slug": "prism",
    "version": "0.1.0",
    "scheme": "prism",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070B",
    "icon": "./assets/brand/app-icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.prism.trainer",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.prism.trainer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "monochromeImage": "./assets/brand/monochrome-icon.png",
        "backgroundColor": "#07070B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#07070B",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07531a6e-d8ce-480a-9adb-74d15db80f76"
      }
    }
  }
}
