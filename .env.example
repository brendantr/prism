# PRism environment
#
# Demo mode runs the entire app on locally generated, deterministic seed data
# with zero network calls.
#
# WHEN THIS IS UNSET, the mode follows the build:
#   * development (Metro, Jest)  -> demo ON
#   * release builds (EAS)       -> demo OFF, real backend required
# Setting it explicitly overrides that in either direction. Leave it as "true"
# here to explore PRism locally with no backend setup.
#
# Build profiles set this themselves -- see eas.json and
# Docs/production-posture-v1.md. Do not rely on the default to pick your mode
# for a release: a release build with demo OFF and no credentials below refuses
# to start rather than falling back to demo, on purpose.
EXPO_PUBLIC_DEMO_MODE=true

# Supabase -- REQUIRED whenever EXPO_PUBLIC_DEMO_MODE is false (which is every
# production build). Both must be set together; one without the other counts as
# unconfigured.
#
# Project Settings -> Data API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=
# Project Settings -> API Keys -> anon / publishable key.
# Safe for clients by design -- it is inlined into the bundle and RLS is the
# actual authorization boundary (Docs/invariants.md I-4, I-6). Never put a
# service-role key here or anywhere else in this repository (I-4, I-5).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry crash-reporting project DSN. Safe for a client bundle by design; it
# grants no dashboard/read access. Leave blank in development and demo builds.
# Source-map upload credentials are build secrets and never belong in this file.
EXPO_PUBLIC_SENTRY_DSN=
