# PRism environment
#
# Demo mode runs the entire app on locally generated, deterministic seed data
# with zero network calls.
#
# WHEN THIS IS UNSET, the mode follows the build:
#   * development (Metro, Jest)  -> demo ON
#   * release builds (EAS)       -> demo OFF, real backend required
# Setting it explicitly overrides that in either direction. Leave it as "true"
# here to explore PRism locally with no backend setup.
#
# Build profiles set this themselves -- see eas.json and
# Docs/production-posture-v1.md. Do not rely on the default to pick your mode
# for a release: a release build with demo OFF and no credentials below refuses
# to start rather than falling back to demo, on purpose.
EXPO_PUBLIC_DEMO_MODE=true

# Supabase -- REQUIRED whenever EXPO_PUBLIC_DEMO_MODE is false (which is every
# production build). Both must be set together; one without the other counts as
# unconfigured.
#
# Project Settings -> Data API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=
# Project Settings -> API Keys -> anon / publishable key.
# Safe for clients by design -- it is inlined into the bundle and RLS is the
# actual authorization boundary (Docs/invariants.md I-4, I-6). Never put a
# service-role key here or anywhere else in this repository (I-4, I-5).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry crash-reporting project DSN. Safe for a client bundle by design; it
# grants no dashboard/read access. Leave blank in development and demo builds.
# Source-map upload credentials are build secrets and never belong in this file.
EXPO_PUBLIC_SENTRY_DSN=

# Does this build sell anything? Default "false" -- omitted counts as false.
#
# A DECLARATION, not an inference. The entitlement store deliberately refuses to
# read a missing RevenueCat key as "free", because that would make deleting a
# key the way to unlock the paid product. This is the build stating on purpose
# that it has no paid tier, which is a different claim and is allowed to unlock.
#
# Left false, Progress, Body's recovery estimate and the 28/84-day Insights
# windows are open. Set to "true" only once RevenueCat has a synced offering --
# true without one reproduces locked-but-unbuyable, which is a store rejection.
EXPO_PUBLIC_MONETIZATION_ENABLED=false

# Can this build deliver a password-reset code? Default "false".
#
# Reset asks the lifter to type six digits. Supabase's default recovery template
# sends a link with no code in it, and the template cannot be edited without
# custom SMTP -- so until both are done, "Forgot password?" leads to a screen
# that waits forever. False hides the control rather than dead-ending it.
# See Docs/store-submission-runbook.md section 3a.
EXPO_PUBLIC_EMAIL_RECOVERY_ENABLED=false

# RevenueCat public SDK keys -- REQUIRED per platform in real purchase builds.
# These are designed to ship in the app bundle. They are NOT RevenueCat secret
# API keys and cannot write PRism's server entitlement table. Obtain them from
# RevenueCat Project settings -> API keys. Server/webhook secrets never belong
# in this file or in any EXPO_PUBLIC_* variable (I-4, I-5, I-9).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
