# PRism environment
#
# Demo mode runs the entire app on locally generated, deterministic seed data.
# Leave this as "true" to explore PRism with zero backend setup.
EXPO_PUBLIC_DEMO_MODE=true

# Supabase (only required when EXPO_PUBLIC_DEMO_MODE=false)
# Project Settings -> Data API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=
# Project Settings -> API Keys -> anon / publishable key (safe for clients, RLS enforced)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
